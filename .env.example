# Copy to .env only for a new checkout. scripts.local_server uses local SQLite/Ollama.
# main:app requires an EXISTING Pinecone index with matching dimensions.
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/ragdb
REDIS_HOST=localhost
REDIS_PORT=6379
PINECONE_API_KEY=replace-me
PINECONE_INDEX_NAME=rag-documents-768
PINECONE_ENVIRONMENT=us-east-1
PINECONE_DIMENSION=768
EMBEDDING_PROVIDER=hf
HF_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
EMBEDDING_DIMENSION=768
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_MAX_OUTPUT_TOKENS=512
# Only used for LLM_PROVIDER=groq; currently required by Settings even for Ollama.
GROQ_API_KEY=unused-with-ollama
STORAGE_DIR=storage
MAX_FILE_SIZE_MB=10
MAX_DOCUMENT_PAGES=50
PROCESSING_TIMEOUT_SECONDS=180
OCR_PAGE_TIMEOUT_SECONDS=30
OCR_LANGUAGE=eng
